{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Settings every repo shares, with dependency updates on Wednesday and Saturday mornings; extend default.json unless the repo needs its own automerge rules",
  "extends": [
    "config:recommended",
    ":configMigration",
    "abandonments:recommended",
    "helpers:pinGitHubActionDigests",
    "security:openssf-scorecard"
  ],
  "assignees": ["cddude229"],
  "reviewers": ["cddude229"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on wednesday", "before 6am on saturday"],
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 5,
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "security:openssf-scorecard replaces the PR table columns; put back the Age and Confidence badges from config:recommended",
      "matchSourceUrls": ["https://github.com/**"],
      "matchDatasources": [
        "go",
        "maven",
        "npm",
        "nuget",
        "packagist",
        "pypi",
        "rubygems"
      ],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "prBodyColumns": ["Package", "Change", "Age", "Confidence", "OpenSSF"]
    }
  ]
}
